<!-- Experiment 1: Design a Webpage using all HTML elements         -->
<!-- File: exp1.html                                                -->
<!-- ============================================================== -->

<!DOCTYPE html>
<html>
<head>
  <title>All HTML Elements</title>
</head>
<body>
  <h1>Heading 1</h1>
  <h2>Heading 2</h2>

  <p>This paragraph demonstrates <b>bold</b>, <i>italic</i>, and <u>underlined</u> text.</p>

  <a href="https://example.com" target="_blank">Sample Hyperlink</a>
  <br><br>

  <img src="photo.jpg" alt="Sample Image" width="150" height="100">

  <h3>Unordered List</h3>
  <ul>
    <li>HTML</li>
    <li>CSS</li>
    <li>JavaScript</li>
  </ul>

  <h3>Ordered List</h3>
  <ol>
    <li>Node.js</li>
    <li>MongoDB</li>
    <li>AngularJS</li>
  </ol>

  <h3>Table</h3>
  <table border="1" cellpadding="6">
    <tr>
      <th>ID</th>
      <th>Name</th>
      <th>Role</th>
    </tr>
    <tr>
      <td>1</td>
      <td>Alice</td>
      <td>Developer</td>
    </tr>
    <tr>
      <td>2</td>
      <td>Bob</td>
      <td>Designer</td>
    </tr>
  </table>

  <h3>Form Controls</h3>
  <form>
    <label>Text Field: <input type="text" name="username"></label><br><br>

    Gender:
    <label><input type="radio" name="gender" value="m"> Male</label>
    <label><input type="radio" name="gender" value="f"> Female</label><br><br>

    Skills:
    <label><input type="checkbox" name="skill" value="web"> Web</label>
    <label><input type="checkbox" name="skill" value="app"> App</label><br><br>

    <label>City:
      <select name="city">
        <option value="chennai">Chennai</option>
        <option value="bangalore">Bangalore</option>
        <option value="mumbai">Mumbai</option>
      </select>
    </label><br><br>

    <input type="submit" value="Submit Form">
    <button type="button" onclick="alert('Button clicked!')">Click Button</button>
  </form>
</body>
</html>
